# HookRelay environment configuration.
# Скопируйте в .env и заполните. .env не коммитится в Git.

# --- PostgreSQL (для docker compose) ---
POSTGRES_USER=relay_user
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=hookrelay_db

# DATABASE_URL — для запуска БЕЗ docker (локальная разработка).
# Внутри compose он формируется автоматически из POSTGRES_*.
# DATABASE_URL=postgres://relay_user:change-me-strong-password@localhost:5432/hookrelay_db?sslmode=disable

# --- API ---
SERVER_PORT=8080
# APP_MODE=api — только HTTP API; worker — только фоновая доставка.
# В compose каждый сервис задаёт свой APP_MODE.
APP_MODE=api

# --- Шифрование секретов endpoint (HMAC-подписи вебхуков) ---
# Обязателен в обоих режимах. Сгенерировать 32-байтный ключ:
#   openssl rand -base64 32
HOOKRELAY_ENCRYPTION_KEY=

# --- Worker (значения по умолчанию показаны) ---
WORKER_BATCH_SIZE=10
WORKER_POLL_INTERVAL=1s
# Должен превышать DELIVERY_HTTP_TIMEOUT + 5s запаса.
WORKER_LEASE_DURATION=30s
DELIVERY_HTTP_TIMEOUT=10s
WORKER_RETRY_DELAY=5s
WORKER_MAX_RETRY_DELAY=5m
# Автоматических повторов после первой попытки (итого до 6 попыток).
WORKER_MAX_RETRIES=5
